#!/usr/bin/env python3
"""Google external-account helper. Its stdout is a credential, never a log."""
import base64
import json
import subprocess
import sys

try:
    token = subprocess.run(
        ["amp", "orb", "id-token", "--audience", "urn:amp:gcp:sponky-junction-2026"],
        check=True, capture_output=True, text=True, timeout=30,
    ).stdout.strip()
    payload = token.split(".")[1]
    expiry = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))["exp"]
    if not isinstance(expiry, int):
        raise ValueError("Invalid expiration")
    print(json.dumps({
        "version": 1, "success": True,
        "token_type": "urn:ietf:params:oauth:token-type:id_token",
        "id_token": token, "expiration_time": expiry,
    }))
except Exception:
    print(json.dumps({"version": 1, "success": False, "code": "AMP_IDENTITY_UNAVAILABLE",
                      "message": "Run inside the authorized Sponky Amp Orb."}))
    sys.exit(1)
