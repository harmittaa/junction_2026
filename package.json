{
  "name": "sponky",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "check": "next typegen && tsc --noEmit && eslint src tests && vitest run && python3 -m unittest discover -s scripts -p 'test_import_transactions.py'",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-sponky 'vitest run --config vitest.emulator.config.ts'"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "firebase-admin": "^13.6.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^14.25.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
