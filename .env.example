# Server only. Never prefix credentials with NEXT_PUBLIC_.
# These names are the handoff contract; application config must consume them.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# demo-* projects work with the Firestore emulator and need no cloud access.
# The deployed project ID lives in apphosting.yaml, not here.
GOOGLE_CLOUD_PROJECT=demo-sponky-local
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
ELEVENLABS_STT_MODEL=scribe_v3_live
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9

# Local runs use the Firestore emulator (npx firebase emulators:start --only firestore),
# not the deployed demo database. Remove this line only on purpose.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Cloud runtime uses its managed service account; Amp uses temporary OIDC.
