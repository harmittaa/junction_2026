# Server only. Never prefix credentials with NEXT_PUBLIC_.
# These names are the handoff contract; application config must consume them.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
SESSION_SECRET=
GOOGLE_CLOUD_PROJECT=sponky-junction-2026
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
ELEVENLABS_STT_MODEL=scribe_v3_live
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9

# Local deterministic runs use the emulator, not the deployed demo database.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Use a demo-* project ID for emulator tests. No cloud credential is needed.
# Cloud runtime uses its managed service account; Amp uses temporary OIDC.
